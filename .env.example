# Copy this to .env and fill in your values

# Supabase
# Get from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here  # NOT the anon key!

# LLM Provider: "groq" (free cloud) or "ollama" (free local)
LLM_PROVIDER=groq

# Groq (Free & Fast) - Get API key at: https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant

# Ollama (100% Local) - Install from: https://ollama.ai, then: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
